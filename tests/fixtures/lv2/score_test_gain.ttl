@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rsz:  <http://lv2plug.in/ns/ext/resize-port#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .

<urn:score:test:gain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Score Test Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "level" ;
        lv2:name "Level"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 3.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .

# Deliberately shares its doap:name with urn:score:test:gain: display names are
# not unique across plug-ins, and descriptor-pinned lookups must not bind this
# one when the descriptor names the other URI.
<urn:score:test:gain2>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Score Test Gain" ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "level" ;
        lv2:name "Level"
    ] .

# Sends a 10000-byte event on "notify" for each block with an input event: a
# plug-in answering its UI with a whole state, which needs the 64 KiB buffers
# it asks for.
<urn:score:test:notify>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Notify" ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        rsz:minimumSize 65536
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "notify" ;
        lv2:name "Notify" ;
        rsz:minimumSize 65536
    ] .

# The same on atom ports that support no MIDI.
<urn:score:test:atom-notify>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Atom Notify" ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        rsz:minimumSize 65536
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 1 ;
        lv2:symbol "notify" ;
        lv2:name "Notify" ;
        rsz:minimumSize 65536
    ] .

# A control read by an X11 UI that resizes itself (score_test_x11ui.c).
<urn:score:test:x11ui>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test X11 UI" ;
    ui:ui <urn:score:test:x11ui#ui> ;
    lv2:port [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "size" ;
        lv2:name "Size" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .

# Follows the host transport through time:Position.
<urn:score:test:transport>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Transport" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "speed" ;
        lv2:name "Speed"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "starts" ;
        lv2:name "Starts"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "frame" ;
        lv2:name "Frame"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "beat" ;
        lv2:name "Beat"
    ] .

# No activate(): counts its runs since it was instantiated.
<urn:score:test:counter>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Counter" ;
    lv2:port [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 0 ;
        lv2:symbol "runs" ;
        lv2:name "Runs"
    ] .

# CV in and out, and a time with a minimum only (no default, no maximum).
# out = gate + time.
<urn:score:test:envelope>
    a lv2:Plugin, lv2:EnvelopePlugin ;
    doap:name "Score Test Envelope" ;
    lv2:port [
        a lv2:CVPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "gate" ;
        lv2:name "Gate"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "time" ;
        lv2:name "Time" ;
        lv2:minimum 0.0
    ] , [
        a lv2:CVPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out" ;
        lv2:name "Envelope Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .

# A frequency given as a fraction of the sample rate (lv2:sampleRate), a plain
# gain, and both echoed on control outputs. out = rate.
<urn:score:test:rate>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Rate" ;
    lv2:port [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "rate" ;
        lv2:name "Rate" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:sampleRate
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "rate_echo" ;
        lv2:name "Rate Echo" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:sampleRate
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "gain_echo" ;
        lv2:name "Gain Echo" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .

# Forwards every event it receives, as an event monitor does: its output says
# it may carry a time:Position. "shortest" is the fewest frames of a run.
<urn:score:test:thru>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Thru" ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "shortest" ;
        lv2:name "Shortest"
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "sequence" ;
        lv2:name "Sequence"
    ] .

<urn:score:test:handover>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Handover" ;
    lv2:port [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 0 ;
        lv2:symbol "active" ;
        lv2:name "Active"
    ] , [
        a atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "side" ;
        lv2:name "Side"
    ] , [
        a atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        lv2:index 2 ;
        lv2:symbol "aux" ;
        lv2:name "Aux"
    ] .

# Copies its input and never writes its MIDI output: the host finds there the
# atom:Chunk it gave, not a sequence.
<urn:score:test:mute>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Mute" ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 2 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out"
    ] .

# Copies its input; each run schedules a work, whose answer schedules another.
<urn:score:test:worker-echo>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Worker Echo" ;
    lv2:requiredFeature work:schedule ;
    lv2:extensionData work:interface ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .

# Copies its input; its first run schedules a work of 300 ms.
<urn:score:test:worker>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Score Test Worker" ;
    lv2:requiredFeature work:schedule ;
    lv2:extensionData work:interface ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] .
