@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<urn:score:test:gain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Score Test Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "level" ;
        lv2:name "Level"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 3.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] .

# Deliberately shares its doap:name with urn:score:test:gain: display names are
# not unique across plug-ins, and descriptor-pinned lookups must not bind this
# one when the descriptor names the other URI.
<urn:score:test:gain2>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "Score Test Gain" ;
    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "level" ;
        lv2:name "Level"
    ] .
